NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Use a chave pública do Supabase. Em projetos novos ela pode aparecer como publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Se o painel do Supabase mostrar apenas "anon public", use esta variável no lugar da publishable.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Nunca coloque a service_role key no app Next.js. Ela ignora RLS e deve ficar só em backend/admin isolado.

# Integração oficial do WhatsApp (somente servidor/Vercel; nunca use prefixo NEXT_PUBLIC_).
# A service_role é exclusiva do backend (webhooks assinados e ações autenticadas).
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# WHATSAPP_VERIFY_TOKEN=crie_um_token_longo_e_aleatorio
# WHATSAPP_APP_SECRET=app_secret_da_meta
# Os envios oficiais usam o token criptografado por conexão, salvo após o Embedded Signup.
# WHATSAPP_CREDENTIAL_ENCRYPTION_KEY=32_bytes_aleatorios_em_hexadecimal_64_caracteres
# Escopo explícito deste CRM (um único cliente/número no MVP; não é isolamento multi-tenant).
# WHATSAPP_ALLOWED_WABA_ID=waba_autorizada
# WHATSAPP_ALLOWED_PHONE_NUMBER_ID=numero_autorizado
# Credenciais temporárias e isoladas para a demonstração da análise do app na Meta.
# Nunca use prefixo NEXT_PUBLIC_ no token.
# WHATSAPP_REVIEW_ACCESS_TOKEN=token_temporario_gerado_na_etapa_experimente
# WHATSAPP_REVIEW_ENABLED=false
# WHATSAPP_REVIEW_PHONE_NUMBER_ID=phone_number_id_do_numero_de_teste
# WHATSAPP_REVIEW_WABA_ID=waba_id_da_conta_de_teste
# WHATSAPP_SYSTEM_USER_ID=uuid_de_um_profile_tecnico_ativo
# WHATSAPP_GRAPH_API_VERSION=vXX.X (use a versão vigente exibida no painel da Meta)
# Identificadores públicos usados pelo Embedded Signup (também configure na Vercel).
# NEXT_PUBLIC_META_APP_ID=id_do_aplicativo_meta
# NEXT_PUBLIC_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=id_da_configuracao_embedded_signup
